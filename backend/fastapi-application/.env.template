# Скопируй этот файл в .env и подставь свои значения:
#   cp fastapi-application/.env.template fastapi-application/.env
#
# Переменные читаются pydantic-settings (core/config.py):
# префикс APP_CONFIG__, вложенность через двойное подчёркивание.

# --- База данных ---
# ВАЖНО: хост зависит от того, откуда запускается приложение.
#   в docker compose (сервис web)  -> pg:5432       (имя сервиса в сети compose)
#   с хост-машины (uvicorn/alembic) -> localhost:5433 (проброшенный порт из compose)
APP_CONFIG__DB__URL=postgresql+asyncpg://postgres:CHANGE_ME@pg:5432/app
APP_CONFIG__DB__ECHO=0

# --- Секреты токенов (сгенерируй свои: openssl rand -hex 32) ---
APP_CONFIG__ACCESS_TOKEN__VERIFICATION_TOKEN_SECRET=CHANGE_ME
APP_CONFIG__ACCESS_TOKEN__RESET_PASSWORD_TOKEN_SECRET=CHANGE_ME

# --- Суперпользователь, создаётся на старте приложения (actions/create_superuser.py) ---
DEFAULT_EMAIL=admin@admin.com
DEFAULT_PASSWORD=CHANGE_ME
